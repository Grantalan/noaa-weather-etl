# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection (used by the ETL and by docker-compose.yml)
PGHOST=localhost
PGPORT=5433
PGDATABASE=ghcnd_etl
PGUSER=
PGPASSWORD=

# Metabase (used by scripts/configure_metabase.py)
MB_URL=http://localhost:3000
MB_ADMIN_EMAIL=
MB_ADMIN_PASSWORD=
MB_ADMIN_FIRST_NAME=
MB_ADMIN_LAST_NAME=
MB_SITE_NAME=Metabase
